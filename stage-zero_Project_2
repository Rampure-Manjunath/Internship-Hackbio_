#!/bin/bash

conda activate base #activating conda base environment

conda create -n funtools python=3.10 pandas numpy #creating a conda environment named funtools

conda activate funtools #activating the funtools environment

sudo apt-get install -y figlet #installing figlet from apt-get

conda install -c bioconda bwa -y #Installing bwa through the bioconda channel

conda install -c bioconda blast -y #Installing blast through the bioconda channel

conda install -c bioconda samtools -y #Installing samtools through the bioconda channel

conda install -c bioconda bedtools -y #Installing bedtools through the bioconda channel

conda install -c bioconda spades -y #Installing spades through the bioconda channel

conda install -c bioconda bcftools -y #Installing bcftools through the bioconda channel

conda install -c bioconda fastp -y #Installing fastp through the bioconda channel

conda install -c bioconda multiqc -y #Installing multiqc through the bioconda channel
